APP_ENV=development
ENABLE_DEV_SESSION=false
DEV_SESSION_SECRET=
APP_HOST=0.0.0.0
APP_PORT=8080

POSTGRES_PASSWORD=replace_with_local_postgres_password
REDIS_PASSWORD=replace_with_local_redis_password
DATABASE_URL=postgresql://postgres:replace_with_local_postgres_password@localhost:15432/aura_shine
REDIS_URL=redis://:replace_with_local_redis_password@localhost:16379/0

JWT_ACCESS_SECRET=replace_with_32_plus_random_chars_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_random_chars_refresh_secret
SECURITY_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:4300,http://localhost:4300
AI_SERVICE_TOKEN=replace_with_32_plus_random_chars_ai_service_token
AI_SERVICE_URL=http://127.0.0.1:8081
VOICE_PROVIDER_TOKEN=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_SAML_CLIENT_ID=
OAUTH_SAML_CLIENT_SECRET=
OAUTH_SAML_REDIRECT_URI=
OAUTH_SAML_ISSUER=
OAUTH_SAML_AUTHORIZATION_ENDPOINT=
OAUTH_SAML_TOKEN_ENDPOINT=
OAUTH_SAML_JWKS_URI=

CONNECTOR_QUICKBOOKS_CLIENT_ID=
CONNECTOR_QUICKBOOKS_CLIENT_SECRET=
CONNECTOR_QUICKBOOKS_REDIRECT_URI=
CONNECTOR_XERO_CLIENT_ID=
CONNECTOR_XERO_CLIENT_SECRET=
CONNECTOR_XERO_REDIRECT_URI=
CONNECTOR_NETSUITE_CLIENT_ID=
CONNECTOR_NETSUITE_CLIENT_SECRET=
CONNECTOR_NETSUITE_REDIRECT_URI=
CONNECTOR_GOOGLE_CLIENT_ID=
CONNECTOR_GOOGLE_CLIENT_SECRET=
CONNECTOR_GOOGLE_REDIRECT_URI=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=aura-shine-dev
# Optional absolute path outside the web root. Defaults to backend-rust/data/migration-files.
MIGRATION_FILE_STORAGE_ROOT=

# Razorpay payment links and signed webhook. Keep all production values in your secret manager.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional payment-link providers. Enable only the providers whose real credentials are configured.
# PAYMENT_PROVIDER_ENVIRONMENT accepts production or sandbox.
PAYMENT_PROVIDER_ENVIRONMENT=production
PAYMENT_RETURN_URL=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Membership/package WhatsApp and email delivery. Webhook handles email and can also handle WhatsApp.
INVOICE_DELIVERY_WEBHOOK_URL=
INVOICE_DELIVERY_WEBHOOK_TOKEN=
COMPLIANCE_PROVIDER_URL=
COMPLIANCE_PROVIDER_TOKEN=
PAYROLL_PAYOUT_PROVIDER_URL=
PAYROLL_PAYOUT_PROVIDER_TOKEN=
MOBILE_PUSH_PROVIDER_URL=
MOBILE_PUSH_PROVIDER_TOKEN=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_INVOICE_TEMPLATE_NAME=
WHATSAPP_BENEFIT_TEMPLATE_NAME=
