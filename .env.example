# --- Core runtime ---
# APP_ENV drives the local-only escape hatches (permissive CORS, dev sessions,
# unauthenticated /metrics), so anything other than a local value hardens them.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Required. docker-compose builds these two from the passwords below; set them
# directly when running the backend outside compose.
DATABASE_URL=
REDIS_URL=

POSTGRES_PASSWORD=replace_with_local_postgres_password
REDIS_PASSWORD=replace_with_local_redis_password
JWT_ACCESS_SECRET=replace_with_32_plus_random_chars_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_random_chars_refresh_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Local development only; config refuses to start with this enabled outside a
# local APP_ENV. DEV_SESSION_SECRET is required whenever it is true.
ENABLE_DEV_SESSION=false
DEV_SESSION_SECRET=
# At least 32 characters. Encrypts MFA secrets, staff statutory identifiers and
# client contact details. Losing it makes every one of those unrecoverable, and
# changing it needs a KEY_VERSION bump so the backfill re-derives — it is not a
# value to rotate casually.
SECURITY_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=
AI_SERVICE_TOKEN=replace_with_32_plus_random_chars_ai_service_token
# Must start with http:// or https:// or the backend ignores it and AI calls
# stay disabled.
AI_SERVICE_URL=
VOICE_PROVIDER_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
CUSTOMER_FIREBASE_API_KEY=
MOBILE_PUSH_PUBLIC_KEY=

# --- App base URLs (used in outbound links and payment returns) ---
CRM_APP_BASE_URL=
CUSTOMER_APP_BASE_URL=
# Must be https:// or it is ignored.
PAYMENT_RETURN_URL=

# --- SSO ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_SAML_CLIENT_ID=
OAUTH_SAML_CLIENT_SECRET=
OAUTH_SAML_REDIRECT_URI=
OAUTH_SAML_ISSUER=
OAUTH_SAML_AUTHORIZATION_ENDPOINT=
OAUTH_SAML_TOKEN_ENDPOINT=
OAUTH_SAML_JWKS_URI=
CONNECTOR_QUICKBOOKS_CLIENT_ID=
CONNECTOR_QUICKBOOKS_CLIENT_SECRET=
CONNECTOR_QUICKBOOKS_REDIRECT_URI=
CONNECTOR_XERO_CLIENT_ID=
CONNECTOR_XERO_CLIENT_SECRET=
CONNECTOR_XERO_REDIRECT_URI=
CONNECTOR_NETSUITE_CLIENT_ID=
CONNECTOR_NETSUITE_CLIENT_SECRET=
CONNECTOR_NETSUITE_REDIRECT_URI=
CONNECTOR_GOOGLE_CLIENT_ID=
CONNECTOR_GOOGLE_CLIENT_SECRET=
CONNECTOR_GOOGLE_REDIRECT_URI=
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# AI Scribe transcription. Leave SCRIBE_PROVIDER empty to keep Scribe off: the
# service returns 503 rather than inventing a transcript, because a fabricated
# clinical note is worse than no note. Only "openai" is wired today.
SCRIBE_PROVIDER=
SCRIBE_MODEL=whisper-1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:4300,http://localhost:4300,http://127.0.0.1:4310,http://localhost:4310,http://127.0.0.1:4320,http://localhost:4320
# --- Payment providers ---
# "production" or "sandbox"; anything unset defaults to production, so set this
# explicitly on staging.
PAYMENT_PROVIDER_ENVIRONMENT=production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Stripe and Adyen back merchant onboarding/KYC, not payment links.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_LIVE_PREFIX=

# --- WhatsApp Cloud ---
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_INVOICE_TEMPLATE_NAME=
WHATSAPP_BENEFIT_TEMPLATE_NAME=

# --- Outbound email (STARTTLS; SMTP_PORT must be 587 or 2587) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL_WEBHOOK_SECRET=

# --- Invoice delivery ---
INVOICE_DELIVERY_WEBHOOK_URL=
INVOICE_DELIVERY_WEBHOOK_TOKEN=

# --- Data migration (import pipeline) ---
# ClamAV for uploaded import files. CLAMD_ADDRESS wins; MIGRATION_CLAMD_ADDRESS
# is the fallback docker-compose sets.
CLAMD_ADDRESS=
MIGRATION_CLAMD_ADDRESS=
MIGRATION_EVIDENCE_ENCRYPTION_KEY=
MIGRATION_PROOF_SIGNING_KEY=

# --- S3 (report exports, migration evidence) ---
AWS_REGION=
AWS_S3_BUCKET=

COMPLIANCE_PROVIDER_URL=
COMPLIANCE_PROVIDER_TOKEN=
PAYROLL_PAYOUT_PROVIDER_URL=
PAYROLL_PAYOUT_PROVIDER_TOKEN=
MOBILE_PUSH_PROVIDER_URL=
MOBILE_PUSH_PROVIDER_TOKEN=
STAFF_APP_MINIMUM_VERSION=0.1.0
STAFF_APP_LATEST_VERSION=0.1.0
STAFF_APP_UPDATE_URL=
STAFF_APP_FORCE_UPDATE_ENABLED=false

# --- Deploy and observability controls ---
# Set false on serving tasks: the deploy pipeline runs a dedicated
# `aura-shine-backend --migrate-only` task first, and letting every replica
# migrate again serialises the whole rollout behind one advisory lock.
# `--migrate-only` always migrates regardless of this value.
RUN_MIGRATIONS_ON_BOOT=true
# Background workers are leader-elected via a lease in worker_leases, so one
# replica holds tenure and the rest skip; leaving this true everywhere is safe.
# Set false on API tasks once a dedicated worker service runs them.
RUN_WORKERS=true
# Per-process SQLx pool size. Multiply by replica count and keep the result
# under the database's max_connections.
DATABASE_MAX_CONNECTIONS=25
# Bearer token for GET /metrics. Unset outside local development means the
# endpoint returns 404 rather than publishing platform-wide operational data.
METRICS_AUTH_TOKEN=
# Optional JSON sink for 5xx incident reports (Sentry, Slack, or similar).
# Empty disables forwarding; failures still reach the structured logs.
ERROR_WEBHOOK_URL=
# Requests slower than this are traced. Defaults to 1ms, which traces nearly
# everything; raise it in production.
TRACE_REQUEST_LATENCY_MS=1
