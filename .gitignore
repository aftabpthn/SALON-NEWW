# Local environment and secrets
.env
.env.*
!.env.example
!**/.env.example

# Dependencies and build output
node_modules/
dist/
www/
.angular/
target/
backend-rust/target-*/
.codex-target/
.codex-target-*/
target_noblock/
out-tsc/
# angular.json points the build cache at a Windows path, which becomes a
# literal "C:" directory when the build runs on Linux/macOS.
C:/
__pycache__/
.venv/
venv/
*.py[cod]

# Local tooling, runtime state, and logs
.agents/
.codex/
.codex-runtime/
.codex-review/
.codex-video-review/
.claude/
artifacts/
tmp_zip_extract/
backend-rust/data/
*.log
*.err
frontend-angular/playwright/.auth/
frontend-angular/playwright-report/
frontend-angular/test-results/

# Terraform local providers, plans, and state
.terraform/
*.tfplan
*.tfstate
*.tfstate.*

# Generated graph caches and snapshots
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-*/
graphify-out/*.tmp.json
customer-app/graphify-out/
staff-app/graphify-out/

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*~
