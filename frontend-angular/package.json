{
  "name": "aura-shine-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "start:stable": "ng serve --watch=false",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.0",
    "typescript": "~5.9.3"
  }
}
